# Syskode Project Hub v8

# Browser-safe Supabase client configuration
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only Supabase Admin API.
# IMPORTANT: Never prefix this with VITE_ and never put it in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional AI functionality used by proposal analysis, vendor proposal import, and RFQ → proposal generation
GEMINI_API_KEY=

# Zoho Books OAuth (server-only)
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
# Must exactly match the Authorized Redirect URI in Zoho API Console.
ZOHO_BOOKS_REDIRECT_URI=https://YOUR-RENDER-SERVICE.onrender.com/api/zoho-books/callback
# Bahrain/global Zoho accounts normally uses .com. Change for another Zoho data center if required.
ZOHO_BOOKS_ACCOUNTS_URL=https://accounts.zoho.com
# Strong random secrets. If omitted the service-role key is used as the fallback crypto seed.
ZOHO_TOKEN_ENCRYPTION_KEY=
ZOHO_OAUTH_STATE_SECRET=
# Optional legacy fallback. v8 lets you choose the invoice Item from Settings → Zoho Books.
ZOHO_BOOKS_ITEM_ID=

NODE_ENV=production
